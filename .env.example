# 미리 생성한 MySQL 데이터베이스와 계정 정보를 입력하세요.
DATABASE_URL=mysql+pymysql://osori:your-password@127.0.0.1:3306/osori?charset=utf8mb4
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# 호출 제한 기본값은 임시이며 팀에서 조정할 수 있습니다.
AUTH_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=30

# 프론트엔드 주소를 쉼표로 구분합니다.
CORS_ORIGINS=http://localhost:5173
AUTH_SIGNUP_RATE_LIMIT=10
# 로그인 후 최대 수명과 갱신 횟수. 상한에 도달하면 재로그인합니다.
AUTH_SESSION_MAX_DAYS=30
AUTH_SESSION_MAX_REFRESHES=1000

# 대회 서버의 IAM 역할로 호출합니다. AWS 액세스 키/개인 AI API 키는 필요 없습니다.
AWS_DEFAULT_REGION=ap-northeast-3
# bedrock을 지정해야 실제 질문 생성이 활성화됩니다. 로컬은 AWS 호출 권한이 필요합니다.
QUESTION_GENERATION_PROVIDER=bedrock
QUESTION_GENERATION_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# 기업 챗봇 인증정보 암호화용 Fernet 키. 인증정보 저장 전에 설정하세요.
# 생성: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# API 서버와 연결 테스트 워커에 동일한 키를 설정하고 별도로 안전하게 보관합니다.
CONNECTION_ENCRYPTION_KEY=

# bedrock을 지정하면 실제 판정을 활성화합니다. API와 평가 워커에 동일하게 적용합니다.
EVALUATION_JUDGE_PROVIDER=bedrock
# 생성용과 다른 모델도 선택할 수 있습니다. 지정 모델은 강제 도구 호출을 지원해야 합니다.
EVALUATION_JUDGE_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
